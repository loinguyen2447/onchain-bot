# ==== Bắt buộc ====
# Token lấy từ @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chat id nhận báo cáo. Lấy bằng cách nhắn /id cho bot sau khi chạy,
# hoặc dùng @userinfobot. Nhiều người nhận thì ngăn cách bằng dấu phẩy.
TELEGRAM_CHAT_ID=123456789

# ==== Tuỳ chọn ====
# Người được phép ra lệnh (mặc định = TELEGRAM_CHAT_ID)
# ALLOWED_CHAT_IDS=123456789,987654321

# Giờ gửi báo cáo tự động mỗi ngày (giờ Việt Nam): 8h sáng và 8h tối
REPORT_TIMES=08:00,20:00
# REPORT_ENABLED=0        # tắt báo cáo tự động

# Coin / khung mặc định
DEFAULT_COIN=BTC
DEFAULT_TF=24h

# Giới hạn sàn muốn theo dõi (mặc định cả 8). Ví dụ chỉ 3 sàn cho nhanh:
# EXCHANGES=binance-cex,okx,bybit

# Thời gian cache dữ liệu DefiLlama (giờ). Dữ liệu on-chain chỉ đổi theo ngày.
CACHE_TTL_HOURS=6

# Timeout tải dữ liệu (giây) — mỗi sàn có thể tải 10–80MB
HTTP_TIMEOUT=300

# Nếu mạng phải đi qua proxy:
# HTTPS_PROXY=http://127.0.0.1:8080

# Múi giờ dùng cho lịch gửi (mặc định Asia/Ho_Chi_Minh)
# TZ_NAME=Asia/Ho_Chi_Minh
